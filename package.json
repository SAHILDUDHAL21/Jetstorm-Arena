{
  "name": "jetstorm-arena",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:server && node .server/server/ws-server.js --dev",
    "dev:web": "next dev",
    "build": "next build",
    "build:server": "tsc -p server.tsconfig.json",
    "start": "npm run build:server && node .server/server/ws-server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:mp": "npm run build:server && node .server/scripts/test-e2e.js"
  },
  "dependencies": {
    "next": "16.4.6",
    "phaser": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
